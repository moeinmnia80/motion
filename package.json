{
  "name": "@moeinmnia/motion",
  "version": "0.3.2",
  "description": "Tiny, headless, dependency-free scroll & interaction animations: reveal, stagger, split/scramble/typewriter text, scroll-scrubbed effects, horizontal scroll, SVG draw, magnetic, spotlight, parallax, cursor, scroll-spy. Vanilla core + thin React adapter.",
  "keywords": [
    "animation",
    "headless",
    "highlight",
    "horizontal-scroll",
    "intersection-observer",
    "magnetic",
    "parallax",
    "react",
    "reveal",
    "scroll",
    "scroll-driven",
    "scrollytelling",
    "scrub",
    "spotlight",
    "spring",
    "svg",
    "text-effects",
    "typewriter"
  ],
  "license": "MIT",
  "author": "Moein Mohammadnia <moeinmnia80@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeinmnia80/motion.git"
  },
  "homepage": "https://github.com/moeinmnia80/motion#readme",
  "bugs": {
    "url": "https://github.com/moeinmnia80/motion/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./styles.css": "./dist/motion.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "vitest run",
    "demo": "esbuild src/core/index.ts --bundle --format=esm --target=es2020 --outfile=demo/motion.js"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "jsdom": "^26.0.0",
    "esbuild": "^0.27.0"
  }
}
